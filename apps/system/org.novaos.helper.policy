<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>NovaOS</vendor>
  <vendor_url>https://novaos.example.org</vendor_url>
  <icon_name>novaos-logo</icon_name>
  <action id="org.novaos.helper">
    <description>Change system settings</description>
    <description xml:lang="pl">Zmiana ustawień systemu</description>
    <message>Authentication is required to change system settings</message>
    <message xml:lang="pl">Aby zmienić ustawienia systemu, wymagane jest uwierzytelnienie</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/novaos/nova-helper</annotate>
  </action>
</policyconfig>
