[Desktop Entry]
Type=Application
Name=Nova Gallery
GenericName=Image Viewer
GenericName[pl]=Galeria zdjęć
Comment=View your photos
Comment[pl]=Przeglądaj swoje zdjęcia
Exec=nova-gallery %f
Icon=nova-gallery
Categories=Graphics;Viewer;
