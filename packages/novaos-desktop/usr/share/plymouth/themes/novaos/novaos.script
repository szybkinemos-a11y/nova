# =====================================================================
#  NovaOS – ekran rozruchu (Plymouth, moduł script)
#  Logo z pulsującą poświatą, pasek postępu, okno hasła (LUKS),
#  komunikaty systemowe.
# =====================================================================

Window.SetBackgroundTopColor(0.043, 0.043, 0.102);
Window.SetBackgroundBottomColor(0.035, 0.055, 0.125);

screen_w = Window.GetWidth();
screen_h = Window.GetHeight();
cx = Window.GetX() + screen_w / 2;
cy = Window.GetY() + screen_h / 2;

# ---------- logo
logo.image = Image("logo.png");
logo.sprite = Sprite(logo.image);
logo.x = cx - logo.image.GetWidth() / 2;
logo.y = cy - logo.image.GetHeight() / 2 - 40;
logo.sprite.SetPosition(logo.x, logo.y, 10);

word.image = Image("wordmark.png");
word.sprite = Sprite(word.image);
word.sprite.SetPosition(cx - word.image.GetWidth() / 2, logo.y + logo.image.GetHeight() + 24, 10);

# ---------- pasek postępu
bar_bg.image = Image("progress_bg.png");
bar_fg.original = Image("progress_fg.png");
bar_bg.sprite = Sprite(bar_bg.image);
bar_x = cx - bar_bg.image.GetWidth() / 2;
bar_y = screen_h * 0.82;
bar_bg.sprite.SetPosition(bar_x, bar_y, 10);
bar_fg.sprite = Sprite();
bar_fg.sprite.SetPosition(bar_x, bar_y, 11);

fun progress_callback(duration, progress) {
    w = Math.Int(bar_fg.original.GetWidth() * progress);
    if (w < 6) w = 6;
    bar_fg.sprite.SetImage(bar_fg.original.Scale(w, bar_fg.original.GetHeight()));
}
Plymouth.SetBootProgressFunction(progress_callback);

# ---------- pulsowanie logo
t = 0;
fun refresh_callback() {
    t++;
    logo.sprite.SetOpacity(0.78 + 0.22 * Math.Sin(t / 18));
}
Plymouth.SetRefreshFunction(refresh_callback);

# ---------- okno hasła (np. szyfrowany dysk LUKS)
entry.image = Image("entry.png");
bullet.image = Image("bullet.png");
lock.image = Image("lock.png");
entry.sprite = Sprite();
lock.sprite = Sprite();
prompt.sprite = Sprite();
bullets = [];

fun display_normal_callback() {
    entry.sprite.SetOpacity(0);
    lock.sprite.SetOpacity(0);
    prompt.sprite.SetOpacity(0);
    for (i = 0; bullets[i]; i++) bullets[i].SetOpacity(0);
    bar_bg.sprite.SetOpacity(1);
    bar_fg.sprite.SetOpacity(1);
}

fun display_password_callback(prompt_text, bullet_count) {
    bar_bg.sprite.SetOpacity(0);
    bar_fg.sprite.SetOpacity(0);
    ex = cx - entry.image.GetWidth() / 2;
    ey = screen_h * 0.74;
    entry.sprite.SetImage(entry.image);
    entry.sprite.SetPosition(ex, ey, 20);
    entry.sprite.SetOpacity(1);
    lock.sprite.SetImage(lock.image);
    lock.sprite.SetPosition(ex + 14, ey + 10, 21);
    lock.sprite.SetOpacity(1);
    prompt.sprite.SetImage(Image.Text(prompt_text, 0.85, 0.84, 0.95));
    prompt.sprite.SetPosition(cx - prompt.sprite.GetImage().GetWidth() / 2, ey - 30, 21);
    prompt.sprite.SetOpacity(1);
    for (i = 0; bullets[i]; i++) bullets[i].SetOpacity(0);
    for (i = 0; i < bullet_count && i < 24; i++) {
        if (!bullets[i]) bullets[i] = Sprite(bullet.image);
        bullets[i].SetPosition(ex + 48 + i * 11, ey + 15, 22);
        bullets[i].SetOpacity(1);
    }
}
Plymouth.SetDisplayNormalFunction(display_normal_callback);
Plymouth.SetDisplayPasswordFunction(display_password_callback);

# ---------- komunikaty
message.sprite = Sprite();
fun message_callback(text) {
    message.sprite.SetImage(Image.Text(text, 0.7, 0.68, 0.85));
    message.sprite.SetPosition(cx - message.sprite.GetImage().GetWidth() / 2, screen_h * 0.9, 10);
}
Plymouth.SetMessageFunction(message_callback);

fun quit_callback() { logo.sprite.SetOpacity(1); }
Plymouth.SetQuitFunction(quit_callback);
