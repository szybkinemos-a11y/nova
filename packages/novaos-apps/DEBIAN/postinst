#!/bin/sh
set -e
if [ "$1" = configure ]; then
    python3 -m compileall -q /usr/lib/novaos/python >/dev/null 2>&1 || true
    # Nova Terminal jako domyślny terminal systemu
    update-alternatives --install /usr/bin/x-terminal-emulator x-terminal-emulator /usr/bin/nova-terminal 60
    command -v update-desktop-database >/dev/null 2>&1 && update-desktop-database -q /usr/share/applications || true
fi
exit 0
