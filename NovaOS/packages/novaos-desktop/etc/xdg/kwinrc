# NovaOS – menedżer okien KWin: animacje, rozmycie, przezroczystość
[Plugins]
blurEnabled=true
contrastEnabled=true
scaleEnabled=true
glideEnabled=false
fadeEnabled=false
slidingpopupsEnabled=true
magiclampEnabled=true
squashEnabled=false
translucencyEnabled=true
wobblywindowsEnabled=false
shakecursorEnabled=true
dimscreenEnabled=true
kwin4_effect_shapecornersEnabled=true

[Effect-blur]
BlurStrength=10
NoiseStrength=3

[Effect-translucency]
MoveResize=85
Dialogs=95
Inactive=100

[Effect-Scale]
InScale=0.85
OutScale=0.85

[org.kde.kdecoration2]
library=org.kde.breeze
theme=Breeze
ButtonsOnLeft=
ButtonsOnRight=IAX
BorderSize=None
BorderSizeAuto=false

[TabBox]
LayoutName=thumbnail_grid

[Windows]
Placement=Centered

[NightColor]
Active=false

[Round-Corners]
# Zaokrąglone rogi wszystkich okien + cienki gradientowy obrys fiolet→niebieski
Size=12
InactiveCornerRadius=12
OutlineThickness=1
InactiveOutlineThickness=1
ActiveOutlineUseCustom=true
ActiveOutlineUsePalette=false
OutlineIsGradient=true
OutlineColor=168,85,247
OutlineColor2=59,130,246
OutlineGradientAngle=45
ActiveOutlineAlpha=150
InactiveOutlineUseCustom=true
InactiveOutlineColor=127,127,160
InactiveOutlineAlpha=40
