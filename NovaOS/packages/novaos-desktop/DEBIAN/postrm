#!/bin/sh
set -e
case "$1" in
    remove|purge|abort-install|abort-upgrade)
        for f in /usr/lib/os-release /etc/lsb-release /etc/issue /etc/issue.net; do
            dpkg-divert --package novaos-desktop --remove --rename --divert "$f.ubuntu" "$f" >/dev/null 2>&1 || true
        done
        update-alternatives --remove default.plymouth /usr/share/plymouth/themes/novaos/novaos.plymouth 2>/dev/null || true
        ;;
esac
exit 0
